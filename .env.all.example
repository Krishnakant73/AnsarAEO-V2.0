# ALL Environment Variables — Consolidated Reference
# Copy this into Vercel Project Settings > Environment Variables before deploying.
# (This consolidates everything scattered across Batches 1, 6, 8, and 13.)

# ---------- Supabase (Batch 1) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM providers (Batch 1, 3) ----------
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ---------- Additional answer engines (Batch 24: Copilot + Grok) ----------
# Grok (xAI) — used by the `grok` engine. https://x.ai/api
GROK_API_KEY=
# Microsoft Copilot has NO public API. To enable the `copilot` engine, point
# these at an OpenAI-compatible proxy you operate. Leave blank to skip Copilot.
COPILOT_API_URL=
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o-mini

# ---------- Cron protection (Batch 4) ----------
CRON_SECRET=

# ---------- Contact form email via Zoho (Batch 6) ----------
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_USER=admin@ansaraeo.com
ZOHO_SMTP_PASS=

# ---------- Razorpay billing (Batch 8) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- WhatsApp Business API (Batch 13) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------- Credential Encryption (Batch 20) ----------
ENCRYPTION_KEY=

# ---------- Local SEO: Google Business Profile audit (Batch 24) ----------
# Optional. Google Places API (New) key for the /dashboard/gbp local-SEO
# audit. Leave blank to disable that feature (route returns a clear error).
# Enable "Places API (New)" in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# ---------- Brand Signals: social listening (Batch 25) ----------
# Optional. YouTube Data API v3 key for the /dashboard/signals YouTube feed.
# Reddit signals need NO key. Leave blank to disable only the YouTube half.
YOUTUBE_API_KEY=

# ---------- Internal LLM worker (provider abstraction) ----------
# Which provider powers AnsarAEO's OWN internal reasoning (content drafts,
# classification, entity extraction, summarization, mission planning).
# Only "openai" is implemented today; claude/gemini/grok/local are registered
# as placeholders behind the same interface. Switch here — no code changes.
INTERNAL_LLM_PROVIDER=openai
# Optional override of the OpenAI model used for internal work.
INTERNAL_LLM_OPENAI_MODEL=gpt-4o-mini
# Future provider keys (placeholders only — not consumed until implemented):
# ANTHROPIC_API_KEY=
# INTERNAL_LLM_GEMINI_KEY=
# INTERNAL_LLM_GROK_KEY=
# INTERNAL_LLM_LOCAL_URL=

# ---------- DataForSEO (SERP + Google AI Overview scraping) ----------
# Used by src/lib/google-ai-overview.ts to fetch real AI Overview content.
# LOGIN is your DataForSEO account email; PASSWORD is the API password shown
# in DataForSEO dashboard > API Access (NOT your login password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---------- OpenRouter (new engine, additive) ----------
# Enables the `openrouter` answer engine in src/lib/visibility-engine.ts.
# Leave blank to skip the engine (same skip pattern as GROK_API_KEY).
# The `engines` row for openrouter is is_active=false by default; flip it on
# in Supabase after confirming the caller works locally.
OPENROUTER_API_KEY=
# Default model routed through OpenRouter. Any provider slug they support.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------- ModelRouter capabilities (Module 9) ----------
# Constitution rule: NEVER hardcode model IDs. Router selects by capability.
# Any provider/model OpenRouter supports. Defaults match the constitution's
# DEFAULT MODEL MAPPING; override any of these without a redeploy.
DEFAULT_MODEL=openai/gpt-4.1-mini
SCORING_MODEL=openai/gpt-4.1-mini
LONG_CONTEXT_MODEL=google/gemini-2.5-flash
RESEARCH_MODEL=perplexity/sonar
REASONING_MODEL=deepseek/deepseek-chat-v3
REPORT_MODEL=anthropic/claude-sonnet-4
SOCIAL_MODEL=x-ai/grok-2-latest
CLASSIFICATION_MODEL=openai/gpt-4.1-mini
UTILITY_MODEL=qwen/qwen-2.5-72b-instruct
FALLBACK_MODEL=openai/gpt-4.1-mini

# ---------- Redis (Module 8 — prompt-hash cache) ----------
# Either a full REDIS_URL, or Upstash REST creds. Adapter picks whichever
# is set. Leave blank for in-memory dev fallback.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Crawler adapter (Module 11) ----------
CRAWLER_PROVIDER=crawl4ai
FIRECRAWL_API_KEY=

# ---------- Stripe (Module 16 — additive alongside Razorpay) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Error tracking: Sentry ----------
# DSN is safe to expose to the browser (NEXT_PUBLIC_*). AUTH_TOKEN is used
# by @sentry/nextjs at build time to upload source maps — server-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ansaraeo
SENTRY_PROJECT=javascript-nextjs

# ---------- Product analytics: PostHog ----------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional — server-side identify + feature-flag usage.
POSTHOG_PERSONAL_API_KEY=

# ---------- Product analytics: Mixpanel ----------
# Dual-track alongside PostHog (PostHog = session replay + flags,
# Mixpanel = funnels + retention). Token is public-safe.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ---------- Google Analytics 4 + Google Tag Manager ----------
# Both are public-safe (they only work with the origin registered in the GA/GTM
# admin console). Leave either blank to disable that tracker; the loader
# in src/components/analytics/GoogleTags.tsx no-ops when the ID is missing.
NEXT_PUBLIC_GA_ID=G-VSPT9BYRWX
NEXT_PUBLIC_GTM_ID=GTM-PDVMRPD9

# ---------- Feature flags: GrowthBook ----------
# Client key is a public read-only key. API host defaults to GrowthBook Cloud.
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
# Optional Vercel Edge Config sync (skip unless you set it up).
# GROWTHBOOK_EDGE_CONNECTION_STRING=
# GROWTHBOOK_EDGE_CONFIG_ITEM_KEY=

# ---------- Uptime + telemetry: Better Stack ----------
# Uptime token identifies the workspace for the Better Stack Uptime API.
BETTER_STACK_UPTIME_TOKEN=
# Telemetry token is bearer-auth for OTLP ingest (used by OTel exporter).
BETTER_STACK_TELEMETRY_TOKEN=

# ---------- Tracing: OpenTelemetry ----------
# Points at Better Stack Telemetry OTLP endpoint (or any OTLP HTTP collector).
# Headers is a comma-separated k=v list; use bearer auth for Better Stack.
OTEL_EXPORTER_OTLP_ENDPOINT=https://in.logs.betterstack.com
OTEL_EXPORTER_OTLP_HEADERS=

# ---------- Background jobs (additive): Inngest ----------
# The Postgres job queue in src/lib/platform/queue.ts keeps running.
# Inngest is for new event-driven workflows only (delays, retry chains).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------- Email (additive): Resend ----------
# Coexists with Zoho SMTP. src/lib/email.ts picks provider per-call.
RESEND_API_KEY=
# Verified sender in Resend dashboard.
RESEND_FROM=noreply@ansaraeo.com

# ---------- Web search: Tavily ----------
# Optional — powers competitor research + content-gap enrichment.
TAVILY_API_KEY=

# ---------- Web crawling: Crawl4AI (sidecar) ----------
# Deploy Crawl4AI (unclecode/crawl4ai) as an HTTP service on Modal/Fly/Render.
# Leave URL blank to fall back to the existing fetch+cheerio pipeline
# used by src/lib/site-audit-engine.ts.
CRAWL4AI_API_URL=
CRAWL4AI_API_KEY=
